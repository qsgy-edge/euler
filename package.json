{
  "name": "euler",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "apps/cli"],
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --test-concurrency=1 apps/cli/test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "demo": "node apps/cli/src/main.ts",
    "evidence": "node scripts/evidence.ts",
    "evidence:memory": "node scripts/evidence-memory.ts",
    "evidence:maintenance": "node scripts/evidence-maintenance.ts",
    "evidence:persistence": "node scripts/evidence-persistence.ts",
    "evidence:guidance": "node scripts/evidence-guidance.ts",
    "evidence:source-recovery": "node scripts/evidence-source-recovery.ts",
    "evidence:owner-memory": "node scripts/evidence-owner-memory.ts",
    "evidence:capture": "node scripts/evidence-capture.ts",
    "evidence:memory-evolution": "node scripts/evidence-memory-evolution.ts",
    "evidence:memory-correction": "node scripts/evidence-memory-correction.ts",
    "evidence:memory-forget": "node scripts/evidence-memory-forget.ts",
    "evidence:memory-rollback": "node scripts/evidence-memory-rollback.ts",
    "evidence:context": "node scripts/evidence-context.ts",
    "evidence:historian": "node scripts/evidence-historian.ts",
    "evidence:backup": "node scripts/evidence-backup.ts",
    "evidence:purge": "node scripts/evidence-purge.ts",
    "evidence:source-cleanup": "node scripts/evidence-source-cleanup.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
